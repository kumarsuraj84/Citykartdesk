# Citykart Desk - every environment variable the application reads, in plain words. Copy to .env.local (the app server keeps two copies: app\standalone\.env.local
# for the web app, and app\.env.local with only what the cron runner needs). NEVER put real values in this file or in git.
# Where each value lives on the live servers: docs/PRODUCTION-INFRASTRUCTURE-AND-MIGRATION.md section 3.
# Check the secrets of a file without printing them:  node scripts/check-secrets.mjs <path to .env.local>
# On start the app also logs a warning for every missing or weak secret below and for a wrong time zone (never the values).

# ── Supabase (required) ─────────────────────────────────────────────────────
# The address of the sign-in / data / file services. Live: the node proxy on the app server, http://10.0.1.98:8443. Local: http://127.0.0.1:54321.
# NEXT_PUBLIC_* values are written into the code when the app is BUILT (browser and server): changing one means a rebuild and a new deploy.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The server's own key (bypasses row security). Server only: never NEXT_PUBLIC, never in the browser, never in logs.
SUPABASE_SERVICE_ROLE_KEY=
# Server-side alias of the address above (same value).
SUPABASE_URL=

# ── App (required) ──────────────────────────────────────────────────────────
# Public address people and e-mails use (live: http://182.72.84.10:3210). Fixed at build time. When it starts with https the cookies become Secure, the
# Strict-Transport-Security header is sent and the security headers follow: see docs/HTTPS-AND-CSP-PLAN.md.
NEXT_PUBLIC_APP_URL=
# The server's time zone. MUST be Asia/Kolkata: business hours, SLA clocks, the 08:00 digest and the cron day/hour gates all follow it. The app warns at start when it is not.
TZ=Asia/Kolkata
# Live server only (leave these two out of a development .env.local): the port the standalone server listens on, and production mode.
# PORT=3210
# NODE_ENV=production
# Number of reverse proxies in FRONT of the app (unset = none, as today: people reach port 3210 directly). With 1, the caller's address is read from X-Forwarded-For
# and per-address limits and address logging switch on. Do NOT set it while the app can also be reached directly (a visitor could invent addresses).
# Without it the sign-in limit follows the account only (a progressive wait, never a hard lock).
TRUSTED_PROXY_HOPS=
# Stamped by scripts/windows/build-for-deploy.ps1 as <date>-<time>-<short commit>; shown by /api/version. Leave empty for local development ("dev").
CK_BUILD_ID=
# 1 at BUILD time sends the content security policy as an enforced rule instead of report-only. Do not switch on before the steps in docs/HTTPS-AND-CSP-PLAN.md.
CSP_ENFORCE=
# Build folder used by the deploy build (.next-deploy) so it never touches the dev server's .next. Set by the build script; leave empty otherwise.
NEXT_DIST_DIR=

# ── Secrets: one per purpose, each at least 16 random characters, all different ───────────────────────────────────
# A missing secret switches only the feature that needs it off (and the app says so at start); it never falls back to another secret.
# Shared secret of the scheduled jobs (x-cron-secret header). Used by scripts/cron-tick.mjs and the cron routes; a value shorter than 16 characters is refused.
CRON_SECRET=
# The log shipper's own secret (scripts/log-shipper.mjs, POST /api/system-log/ingest). The cron secret may only add entries of source 'cron' there.
SYSTEM_LOG_INGEST_SECRET=
# Sign the approve / reject links and the rating links sent by e-mail.
APPROVAL_LINK_SECRET=
CSAT_LINK_SECRET=
# Signs the state of the Gmail / Outlook connection screen (intake channels).
OAUTH_STATE_SECRET=
# Token in the URL of the Gmail / Outlook / WhatsApp intake webhooks.
INTAKE_WEBHOOK_TOKEN=
# Shared secret with the separate intake worker (INTAKE_WORKER_URL).
INTAKE_WORKER_SECRET=
# Transitional switch: 1 lets the purposes above use CRON_SECRET when their own secret is missing. Leave EMPTY; the app warns while it is on.
ALLOW_SHARED_SECRET_FALLBACK=

# ── Cron runner (scripts/cron-tick.mjs; set by scripts\windows\run-cron-tick.ps1 from app\.env.local) ───────────────────────────
# Base address the runner calls (live: http://127.0.0.1:3210, from the same machine).
CRON_TARGET_URL=
# Comma-separated jobs this run executes (names: see JOB_PATHS in scripts/cron-tick.mjs). Default: alerts,business-rules.
CRON_JOBS=alerts,business-rules
# One time limit for every job in milliseconds (default: 9 minutes, 50 seconds for email-reply-sync). Mostly for tests.
CRON_TIMEOUT_MS=
# Log shipper: base address (falls back to CRON_TARGET_URL).
SYSTEM_LOG_TARGET_URL=

# ── System Log ────────────────────────────────────────────────────────────────
# Years the audit and security records stay in the live table before they are MOVED to the archive (default 7, never less than 1).
SYSTEM_LOG_AUDIT_YEARS=
# Folder where log lines wait when the database cannot be reached (default: a folder in the system temp directory).
SYSTEM_LOG_SPOOL_DIR=
# Where a message goes when something needs an operator's attention (an alert webhook, e.g. a chat channel); empty = only the System Log.
OPERATOR_ALERT_WEBHOOK_URL=

# ── Sign-in ─────────────────────────────────────────────────────────────────────
# The "forgot password" answer is never given sooner than this many milliseconds, so the time taken cannot tell known from unknown addresses (default 1500 in production).
FORGOT_PASSWORD_MIN_MS=

# ── Browser push notifications (optional) ─────────────────────────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@citykart.org
# Extra host names (comma-separated) browsers' push services may use besides the built-in list.
PUSH_ENDPOINT_EXTRA_HOSTS=

# ── Attachments ───────────────────────────────────────────────────────────────────
# Virus scanner: clamd. Leave empty and uploads are checked by type, signature and macros only. With ATTACHMENT_SCANNER=clamd the HOST is required
# (without it uploads are refused as "cannot be checked").
ATTACHMENT_SCANNER=
ATTACHMENT_SCANNER_HOST=
ATTACHMENT_SCANNER_PORT=3310
# What to do when the scanner cannot be reached: empty / reject = refuse the upload (safe), allow = let it through.
ATTACHMENT_SCAN_ON_ERROR=
# 1 lets Office files with macros through. Leave empty.
ALLOW_MACRO_OFFICE_FILES=

# ── E-mail ─────────────────────────────────────────────────────────────────────────
# The company mail domain(s), comma-separated (for example citykart.org): invitations to other domains can be refused by policy.
ORG_MAIL_DOMAINS=
# Normally the mailbox is saved in the app (Admin > Platform Settings > Integrations, stored encrypted in the database). These are the older fallback:
# SMTP through a mailbox you own (Google Workspace needs an App Password); used first when SMTP_HOST is set.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM_ADDRESS=
# Or Resend (used only when SMTP_HOST is not set).
RESEND_API_KEY=
EMAIL_FROM=
# TEST ONLY: write mails to files in this folder instead of sending (never set on a live server).
MAIL_SINK_DIR=

# ── Google Sheets (AC / Genset / CVM / PMS sheets) ──────────────────────────────────
# TEST ONLY: read the sheets from files in this folder instead of Google.
MASTERS_DEMO_DIR=

# ── Intake: inbound e-mail (optional, only when the intake module is used) ────────────────
INTAKE_WORKER_URL=
INTAKE_POLL_INTERVAL_MS=
INTAKE_AUTO_ESCALATE=
INTAKE_CLASSIFY_SINCE_DAYS=
# Gmail push deliveries: Google's signed token. Set BOTH together; without them only the URL token protects the webhook.
GMAIL_PUSH_OIDC_AUDIENCE=
GMAIL_PUSH_OIDC_EMAIL=
# true = accept the URL token alone (not recommended).
GMAIL_PUSH_ALLOW_TOKEN_ONLY=

# ── Intake: automatic classification by an outside AI service (optional) ──────────────────────
# DATA LEAVES THE COMPANY: when INTAKE_LLM_API_KEY is set, the text of incoming e-mails (subject, body up to INTAKE_LLM_MAX_BODY_CHARS, sender) is SENT to the
# provider named below (api.groq.com by default) so it can suggest a category. Switch it on only with the owner's decision and any consent / privacy
# review that requires; leave the key empty to keep all mail text inside the company.
INTAKE_LLM_PROVIDER=
INTAKE_LLM_MODEL=
INTAKE_LLM_BASE_URL=
INTAKE_LLM_API_KEY=
INTAKE_LLM_MAX_RETRIES=
INTAKE_LLM_MIN_INTERVAL_MS=
INTAKE_LLM_MAX_BODY_CHARS=
INTAKE_LLM_PRICE_IN_PER_M=
INTAKE_LLM_PRICE_OUT_PER_M=

# ── Intake: Gmail / Outlook connection (optional) ─────────────────────────────────────────────
OAUTH_REDIRECT_BASE_URL=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_PUBSUB_TOPIC=
MS_OAUTH_CLIENT_ID=
MS_OAUTH_CLIENT_SECRET=

# ── Intake: WhatsApp (Meta Cloud API, optional) ──────────────────────────────────────────────
# The access token / app secret / verify token of a WhatsApp channel are NOT here: they are saved per channel in the app (stored encrypted). Only the API version:
META_GRAPH_API_VERSION=

# ── Tests only (never on a server) ─────────────────────────────────────────────────────────
# The default test run refuses to start unless NEXT_PUBLIC_SUPABASE_URL / SUPABASE_URL point at this machine; 1 overrides that on purpose.
ALLOW_NON_LOCAL_TESTS=
# 1 makes the System Log write to the database under Vitest (some tests need it).
SYSTEM_LOG_IN_TESTS=
SHORT_CACHE_IN_TESTS=
