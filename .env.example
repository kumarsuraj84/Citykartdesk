# Copy to .env.local and fill in. See docs/RAILWAY-DEPLOYMENT.md for deploy-time setup.

# ── Supabase (required) ─────────────────────────────────────────────────────
# Project Settings → API. NEXT_PUBLIC_* are exposed to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Server-side-only alias of the URL, used by a couple of server contexts. Same value as
# NEXT_PUBLIC_SUPABASE_URL.
SUPABASE_URL=

# ── App (required) ──────────────────────────────────────────────────────────
# Public base URL of this deployment (e.g. the Railway public URL). Used to build
# absolute links in emails/notifications.
NEXT_PUBLIC_APP_URL=

# Server process timezone. Every Date/Intl call that doesn't pass an explicit
# timeZone (server-rendered timestamps, the SLA business-hours engine, the
# cron day/hour gates in app/api/alerts/run and app/api/business-rules/run) resolves
# against this. Baked into the Docker image's runner stage already — set here
# too so local `npm run dev` matches production instead of defaulting to UTC.
TZ=Asia/Kolkata

# ── Cron / scheduled jobs (required for business rules, alerts, DeskTime sync,
# intake classification — see docs/RAILWAY-DEPLOYMENT.md "Scheduled jobs") ────
# Shared secret checked via lib/cron-auth.ts (Authorization: Bearer <secret> or
# x-cron-secret: <secret>).
CRON_SECRET=
# Only used by scripts/cron-tick.mjs (the separate cron-runner service) — the web
# service's own URL, and which jobs this cron-tick instance should ping.
CRON_TARGET_URL=
CRON_JOBS=alerts,business-rules

# ── Email (optional — leave unset to disable outbound email) ──────────────────
RESEND_API_KEY=
EMAIL_FROM=

# ── Intake: inbound email worker (optional, only needed if the intake module is
# enabled) ──────────────────────────────────────────────────────────────────
INTAKE_WORKER_URL=
INTAKE_WORKER_SECRET=
INTAKE_POLL_INTERVAL_MS=
INTAKE_AUTO_ESCALATE=
INTAKE_CLASSIFY_SINCE_DAYS=

# ── Intake: LLM classification (optional, only needed if intake auto-classification
# is enabled) ────────────────────────────────────────────────────────────────
INTAKE_LLM_PROVIDER=
INTAKE_LLM_MODEL=
INTAKE_LLM_BASE_URL=
INTAKE_LLM_API_KEY=
INTAKE_LLM_MAX_RETRIES=
INTAKE_LLM_MIN_INTERVAL_MS=
INTAKE_LLM_MAX_BODY_CHARS=
INTAKE_LLM_PRICE_IN_PER_M=
INTAKE_LLM_PRICE_OUT_PER_M=

# ── Intake: OAuth (Gmail / Outlook channel connection — optional) ─────────────
OAUTH_REDIRECT_BASE_URL=
OAUTH_STATE_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_PUBSUB_TOPIC=
MS_OAUTH_CLIENT_ID=
MS_OAUTH_CLIENT_SECRET=

# ── Intake: WhatsApp (Meta Cloud API — optional, only needed to use a WhatsApp
# channel). Per-channel access token/app secret/webhook verify token are stored
# in Supabase Vault via a WhatsApp channel's "Connect credentials" form
# (Admin → Intake → Channels), NOT here — see STAGE_5_REPORT.md "Secret
# Storage". This is the one deployment-wide, non-secret setting. ─────────────
# Graph API version to call, e.g. v23.0. Falls back to a documented default
# (lib/whatsapp/config.ts) if unset — a channel's own config can still
# override this per-WABA.
META_GRAPH_API_VERSION=

# ── api/ standalone worker service only ────────────────────────────────────────
PORT=
NODE_ENV=
