# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# api worker service build artifacts
/api/node_modules
/api/dist

# testing
/coverage

# next.js
/.next/
/.next-deploy/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# supabase local state (not needed in version control)
supabase/.branches
supabase/.temp
.claude/worktrees/

# local pg_dump snapshots taken before destructive cleanup ops — large
# binary DB dumps, not source, never belongs in git
/backups/
/local_data_dump.sql
/local_storage_files.tar.gz
/local-backup-*.dump
/main-config-mirror-*.dump
/security-assessment-2026-10/07-FINAL-REMEDIATION/rehearsal/*.dump
/security-assessment-2026-10/07-FINAL-REMEDIATION/rehearsal/schema_*.sql

# raw test/scan/rehearsal logs of the 2026-10 security assessment: they contain synthetic tokens, test e-mail addresses and local paths; the written
# results are in the numbered .md reports (07-FINAL-REMEDIATION), the machine-readable evidence (json/txt state files) is kept
/security-assessment-2026-10/07-FINAL-REMEDIATION/logs/
/security-assessment-2026-10/07-FINAL-REMEDIATION/rehearsal/*.log
/security-assessment-2026-10/07-FINAL-REMEDIATION/scans/*.log
/security-assessment-2026-10/02-VAPT/work/*.log
/security-assessment-2026-10/02-VAPT/work/uat-users.json
/security-assessment-2026-10/05-REMEDIATION/perf-run.json
# read-only snapshots of the LIVE database (production-derived: counts and rights of the live system) - kept on the owner's/dev machine only
/security-assessment-2026-10/07-FINAL-REMEDIATION/live-readonly/live-state.txt
/security-assessment-2026-10/07-FINAL-REMEDIATION/live-readonly/live-schema.sql
/security-assessment-2026-10/07-FINAL-REMEDIATION/rehearsal/live-start/schema_*.sql
/security-assessment-2026-10/07-FINAL-REMEDIATION/rehearsal/*.dump
/local-mail-outbox/
