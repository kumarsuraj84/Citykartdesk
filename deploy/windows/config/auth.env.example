DATABASE_URL="postgres://citykart_desk_app:<DB_PASSWORD>@127.0.0.1:5432/citykart_desk?sslmode=disable"
GOTRUE_DB_DRIVER="postgres"
GOTRUE_DB_MAX_POOL_SIZE="10"
GOTRUE_DB_CONN_MAX_LIFETIME="1h"

GOTRUE_JWT_SECRET="<JWT_SECRET>"
GOTRUE_JWT_EXP="3600"
GOTRUE_JWT_AUD="authenticated"
GOTRUE_JWT_DEFAULT_GROUP_NAME="authenticated"
GOTRUE_JWT_ADMIN_ROLES="service_role"

# Optional: asymmetric (ES256) signing key, in addition to GOTRUE_JWT_SECRET
# above. Without this, GoTrue signs every token with the symmetric secret and
# serves an empty /.well-known/jwks.json, which forces every downstream
# getClaims() call (proxy.ts) into a real network round-trip to GoTrue's
# /user endpoint instead of verifying locally - the dominant cause of the
# auth-related latency documented in
# docs/CITYKART-DESK-DEPLOYMENT-PARITY-AND-PERFORMANCE-REMEDIATION.md.
# Generate with: node deploy/windows/generate-jwt-signing-key.js "<current GOTRUE_JWT_SECRET>"
# then paste its "services/auth/.env" output value below.
# Do NOT remove/rotate GOTRUE_JWT_SECRET when adding this - GoTrue's
# FindPublicKeyByKid() falls back to it for every token issued before this
# key existed (they carry no "kid" claim). See docs/WINDOWS-DEPLOYMENT.md,
# "JWT signing keys (JWKS)" for the full rollout/rollback procedure.
# GOTRUE_JWT_KEYS='[{"kty":"EC","crv":"P-256","x":"...","y":"...","d":"...","kid":"...","alg":"ES256","use":"sig","key_ops":["sign"]}]'

GOTRUE_API_HOST="0.0.0.0"
GOTRUE_API_PORT="9999"

GOTRUE_SITE_URL="http://<SERVER_IP>:3210"
GOTRUE_URI_ALLOW_LIST="http://<SERVER_IP>:3210,http://<SERVER_IP>:3210/**"

GOTRUE_DISABLE_SIGNUP="true"
GOTRUE_EXTERNAL_EMAIL_ENABLED="true"
GOTRUE_EXTERNAL_PHONE_ENABLED="false"
GOTRUE_MAILER_AUTOCONFIRM="true"

GOTRUE_LOG_LEVEL="info"
# No prefix - unlike every other GOTRUE_* var above. GoTrue's own example.env
# confirms this one is unprefixed; a GOTRUE_API_EXTERNAL_URL variant silently
# does nothing and migrate/serve fails with "required key API_EXTERNAL_URL
# missing value".
API_EXTERNAL_URL="http://<SERVER_IP>:8443/auth/v1"
