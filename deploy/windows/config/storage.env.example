SERVER_HOST=0.0.0.0
SERVER_PORT=5000
SERVER_REGION=local

AUTH_JWT_SECRET=<JWT_SECRET>
AUTH_JWT_ALGORITHM=HS256
AUTH_ENCRYPTION_KEY=<32_HEX_CHARS>

# Optional, only needed if GOTRUE_JWT_KEYS is configured on the Auth service
# (see config/auth.env.example) - add the PUBLIC EC key so Storage can verify
# the new ES256 tokens too. AUTH_JWT_SECRET/AUTH_JWT_ALGORITHM above stay as
# they are: Storage's own JWT verification (src/internal/auth/jwt.ts) has an
# explicit fast path that keeps using the flat secret for any token with no
# "kid" claim, which covers every token issued before this key existed.
# Use the "services/storage-src/.env" output of
# deploy/windows/generate-jwt-signing-key.js.
# JWT_JWKS='{"keys":[{"kty":"EC","crv":"P-256","x":"...","y":"...","kid":"...","alg":"ES256","use":"sig","key_ops":["verify"]}]}'

DATABASE_URL=postgresql://citykart_desk_app:<DB_PASSWORD>@127.0.0.1:5432/citykart_desk?sslmode=disable
DATABASE_CONNECTION_TIMEOUT=3000
DATABASE_SEARCH_PATH=
DATABASE_APPLICATION_NAME="Citykart Storage"
DATABASE_MAX_CONNECTIONS=10

DB_INSTALL_ROLES=false
DB_ANON_ROLE=anon
DB_SERVICE_ROLE=service_role
DB_AUTHENTICATED_ROLE=authenticated
DB_SUPER_USER=postgres

UPLOAD_FILE_SIZE_LIMIT=524288000
UPLOAD_FILE_SIZE_LIMIT_STANDARD=52428800
UPLOAD_SIGNED_URL_EXPIRATION_TIME=60
TUS_URL_PATH=/upload/resumable

STORAGE_BACKEND=file
STORAGE_FILE_BACKEND_PATH=E:\CK Projects\CitykartDesk\storage-data

IMAGE_TRANSFORMATION_ENABLED=false
RATE_LIMITER_ENABLED=false
