NEXT_PUBLIC_SUPABASE_URL=http://<SERVER_IP>:8443
NEXT_PUBLIC_SUPABASE_ANON_KEY=<ANON_KEY>
SUPABASE_SERVICE_ROLE_KEY=<SERVICE_ROLE_KEY>
SUPABASE_URL=http://<SERVER_IP>:8443

NEXT_PUBLIC_APP_URL=http://<SERVER_IP>:3210
TZ=Asia/Kolkata

CRON_SECRET=<RANDOM_SECRET>
CRON_TARGET_URL=http://<SERVER_IP>:3210
CRON_JOBS=alerts,business-rules

PORT=3210
NODE_ENV=production

# ── secrets: ONE per purpose, each at least 16 random characters, all different (node scripts/check-secrets.mjs <this file> checks them) ──
# CRON_SECRET above is used only by the cron runner and the routes it calls (too short = every job is refused). The log shipper and the e-mailed links have their own:
SYSTEM_LOG_INGEST_SECRET=<RANDOM_SECRET_2>   # the log shipper (scripts/log-shipper.mjs); the cron secret may only add 'cron' entries to the System Log
APPROVAL_LINK_SECRET=<RANDOM_SECRET_3>       # signs the approve / reject links in e-mails
CSAT_LINK_SECRET=<RANDOM_SECRET_4>           # signs the rating links in e-mails
# OAUTH_STATE_SECRET, INTAKE_WEBHOOK_TOKEN, INTAKE_WORKER_SECRET: only when Gmail/Outlook/WhatsApp intake or the worker is used (see .env.example)

# How many reverse proxies sit in front of the app (0/unset = none: the app is reached directly on port 3210, as today). With 1, the caller's address is read from
# X-Forwarded-For, and per-address limits and address logging work. NEVER set it when the app can be reached directly as well: a visitor could then invent addresses.
# TRUSTED_PROXY_HOPS=1
